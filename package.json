{
  "name": "worlds-simplest-gym",
  "productName": "Worlds Simplest Gym",
  "version": "1.3.1",
  "private": true,
  "type": "module",
  "description": "A local gym planner with workout logging and progression.",
  "author": "Worlds Simplest Gym",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "electron .",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "npm run build && node scripts/test-ui.mjs",
    "test:animals": "npm run build && node scripts/test-animals.mjs",
    "test:tutorial": "npm run build && node scripts/test-tutorial.mjs",
    "test:a11y": "npm run build && node scripts/test-accessibility.mjs",
    "check": "npm test && npm run build",
    "dist": "npm run check && electron-builder --win nsis"
  },
  "dependencies": {
    "electron-store": "8.2.0",
    "nodemailer": "^10.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.55.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "prettier": "^3.9.6",
    "vite": "^8.2.2"
  },
  "build": {
    "electronDist": "node_modules/electron/dist",
    "appId": "com.worldssimplestgym.app",
    "productName": "Worlds Simplest Gym",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/core.js",
      "src/catalog.js",
      "src/planner.js",
      "src/schedule.js",
      "package.json"
    ],
    "win": {
      "icon": "resources/icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
